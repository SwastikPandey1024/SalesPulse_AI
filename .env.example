# SalesPulse AI - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.

# Database Configuration
# Uses SQLite in WAL mode by default. Override for custom path or Postgres:
SALESPULSE_DATABASE_URL=sqlite:///salespulse_audit.db

# API Service Configuration
SALESPULSE_API_HOST=127.0.0.1
SALESPULSE_API_PORT=8000
SALESPULSE_ENABLE_DOCS=true

# Security & CORS Origins (comma-separated list of allowed origins)
# Note: Wildcard '*' with credentials enabled is strictly forbidden by policy.
SALESPULSE_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# File Upload Restrictions (in bytes; default 10MB = 10485760)
SALESPULSE_MAX_UPLOAD_SIZE_BYTES=10485760
